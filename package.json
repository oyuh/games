{
  "name": "games-refac",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "local": "node ./scripts/local.mjs",
    "local:up": "node ./scripts/local.mjs up",
    "local:up:host": "node ./scripts/local.mjs up --host",
    "local:down": "node ./scripts/local.mjs down",
    "local:reset": "node ./scripts/local.mjs reset",
    "local:status": "node ./scripts/local.mjs status",
    "local:logs": "node ./scripts/local.mjs logs",
    "local:restart": "node ./scripts/local.mjs restart",
    "local:doctor": "node ./scripts/local.mjs doctor",
    "build": "turbo run build --cache-dir=.turbo-cache",
    "test": "turbo run test --cache-dir=.turbo-cache",
    "test:ci": "turbo run test:ci --cache-dir=.turbo-cache",
    "test:watch": "bun --filter @games/shared test:watch",
    "test:e2e": "playwright test -c e2e",
    "lint": "turbo run lint --cache-dir=.turbo-cache",
    "typecheck": "turbo run typecheck --cache-dir=.turbo-cache",
    "db:push": "bun --filter @games/shared db:push",
    "db:push:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/db-push-prod.ps1",
    "db:push:prod:linux": "bash ./scripts/db-push-prod.sh",
    "db:studio": "bun --filter @games/shared db:studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
